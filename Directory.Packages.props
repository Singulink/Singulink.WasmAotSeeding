<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Generator">
    <!-- The version Uno.Wasm.Bootstrap's seeding uses -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup Label="Null checks">
    <PackageVersion Include="Singulink.RuntimeNullables" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
